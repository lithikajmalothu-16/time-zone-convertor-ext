{
  "manifest_version": 3,
  "name": "TimePort — Instant Timezone Converter",
  "version": "1.0.0",
  "description": "See any time — '3pm EST', '14:00 CET', '9:30 AM PST' — in YOUR timezone. Works on LinkedIn, Gmail, WhatsApp Web, anywhere.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TimePort — convert any time"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tz.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
